{
  "title": "URL Shortener - System Overview",
  "tags": ["url-shortener", "distributed"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "Request Rate (req/sec)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{
        "datasource": {"type": "prometheus"},
        "expr": "rate(urlshortener_requests_total[1m])",
        "legendFormat": "{{instance}} - {{endpoint}}"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {"mode": "palette-classic"}
        }
      }
    },
    {
      "id": 2,
      "title": "Cache Hit Ratio",
      "type": "gauge",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
      "targets": [{
        "datasource": {"type": "prometheus"},
        "expr": "sum(rate(urlshortener_cache_hits_total[5m])) / (sum(rate(urlshortener_cache_hits_total[5m])) + sum(rate(urlshortener_cache_misses_total[5m])))",
        "legendFormat": "Hit Ratio"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 0.5},
              {"color": "green", "value": 0.8}
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Active Hash Ring Nodes",
      "type": "stat",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
      "targets": [{
        "datasource": {"type": "prometheus"},
        "expr": "urlshortener_active_ring_nodes",
        "legendFormat": "Nodes"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 2},
              {"color": "green", "value": 3}
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "p95 Request Latency",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{
        "datasource": {"type": "prometheus"},
        "expr": "histogram_quantile(0.95, rate(urlshortener_request_latency_seconds_bucket[1m]))",
        "legendFormat": "p95 {{endpoint}}"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {"mode": "palette-classic"}
        }
      }
    },
    {
      "id": 5,
      "title": "URLs Created Total",
      "type": "stat",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 8},
      "targets": [{
        "datasource": {"type": "prometheus"},
        "expr": "sum(urlshortener_urls_created_total)",
        "legendFormat": "Total URLs"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"fixedColor": "blue", "mode": "fixed"}
        }
      }
    },
    {
      "id": 6,
      "title": "Cache Hits vs Misses",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 8},
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "rate(urlshortener_cache_hits_total[1m])",
          "legendFormat": "Cache HIT"
        },
        {
          "datasource": {"type": "prometheus"},
          "expr": "rate(urlshortener_cache_misses_total[1m])",
          "legendFormat": "Cache MISS"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {"mode": "palette-classic"}
        }
      }
    }
  ],
  "time": {"from": "now-15m", "to": "now"}
}